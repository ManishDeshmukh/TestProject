#!/usr/bin/env python3
"""jp — JobPilot CLI launcher (replaces bsub).

Thin shim so the tool can be invoked as ``./jp …`` from a checkout without
installation. Adds the project root to sys.path and delegates to jobpilot.cli.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from jobpilot.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
